<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MongoDB Auth</title><link rel="stylesheet" href="/style.css"></head><body><main><h1>User Registration and Login</h1><% if(message){%><p class="message"><%=message%></p><%}%><% if(user){%><h2>Welcome, <%=user.name%>!</h2><p><%=user.email%></p><form method="post" action="/logout"><button>Logout</button></form><%}else{%><div class="forms"><form method="post" action="/register"><h2>Register</h2><input name="name" placeholder="Name" required><input name="email" type="email" placeholder="Email" required><input name="password" type="password" placeholder="Password" required><button>Create account</button></form><form method="post" action="/login"><h2>Login</h2><input name="email" type="email" placeholder="Email" required><input name="password" type="password" placeholder="Password" required><button>Login</button></form></div><%}%></main></body></html>
